{
	"name": "n8n-nodes-manypi",
	"version": "0.1.0",
	"description": "n8n nodes for ManyPI: run scrapers and AI agents, find and verify leads, and run cold email outreach.",
	"license": "MIT",
	"homepage": "https://github.com/manypicom/n8n-nodes-manypi#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"manypi",
		"web scraping",
		"lead generation",
		"cold email",
		"ai agent"
	],
	"author": {
		"name": "ManyPI",
		"email": "hello@manypi.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/manypicom/n8n-nodes-manypi.git"
	},
	"bugs": {
		"url": "https://github.com/manypicom/n8n-nodes-manypi/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "n8n-node build && node --test test/nodes.test.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ManyPiApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ManyPi/ManyPi.node.js",
			"dist/nodes/ManyPi/ManyPiTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
